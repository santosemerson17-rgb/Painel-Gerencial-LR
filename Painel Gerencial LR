{
nome:"Pasta IT",
link:"https://bravologcombr0.sharepoint.com/:f:/r/sites/LogsticaReversaEvolog/Shared%20Documents/Geral/Procedimentos?d=webc347bbe3a143059f1f62c8ef636c4b&csf=1&web=1&e=KJTHk9"
}

]

}


function abrirAba(aba){

const grid = document.getElementById("grid")

grid.innerHTML=""

let lista = []

if(aba==="favoritos"){

lista = favoritos

}else{

lista = dados[aba] || []

}

lista.forEach(planilha =>{

const card = document.createElement("div")

card.className="card"

card.innerHTML = `

<div class="actions">

<span class="icon" onclick='favoritar(${JSON.stringify(planilha)})'>⭐</span>

<span class="icon" onclick='baixar("${planilha.link}")'>⬇</span>

${aba==="favoritos" ? `<span class="icon" onclick='removerFavorito("${planilha.link}")'>❌</span>`:""}

</div>

<div class="card-title">${planilha.nome}</div>

<a class="open-btn" href="${planilha.link}" target="_blank">Abrir Link</a>

<select class="open-mode" onchange='abrirModo(this.value,"${planilha.link}")'>

<option selected disabled>Abrir...</option>

<option value="excel">Excel</option>

<option value="online">Online</option>

</select>

`

grid.appendChild(card)

})

}


/* FAVORITAR */

function favoritar(planilha){

if(!favoritos.find(p=>p.link===planilha.link)){

favoritos.push(planilha)

localStorage.setItem("favoritos",JSON.stringify(favoritos))

alert("Adicionado aos favoritos")

}

}

/* REMOVER */

function removerFavorito(link){

favoritos = favoritos.filter(p=>p.link!==link)

localStorage.setItem("favoritos",JSON.stringify(favoritos))

abrirAba("favoritos")

}

/* DOWNLOAD */

function baixar(link){

let downloadLink = link;

/* remove parâmetros existentes */
downloadLink = downloadLink.split("?")[0];

/* força download */
downloadLink = downloadLink + "?download=1";

window.open(downloadLink, "_blank");

}

/* ABRIR MODO */

function abrirModo(modo,link){

if(modo==="excel"){

const excelLink = "ms-excel:ofe|u|" + link
window.location.href = excelLink

}

if(modo === "online"){

window.open(link + "?web=1", "_blank")

}

}
/* INICIO */

abrirInicio()

function abrirInicio(){

const grid = document.getElementById("grid")

grid.innerHTML = `

<div class="inicio-container">

<img src="https://www.anicer.com.br/wp-content/uploads/2015/01/LOGISTICA-REVERSA1.png" class="logo">

<h1 class="titulo-painel">
Painel Gerencial<br>
<span>Controle de Planilhas</span>
</h1>

<p>
Central de acesso rápido às planilhas operacionais.<br>
Utilize o menu lateral para navegar entre os recursos.
</p>

<div class="info-box">

<div>
📅 Data: ${new Date().toLocaleDateString()}
</div>

<div>
📊 Total de Planilhas: ${Object.values(dados).flat().length}
</div>

<div>
⭐ Favoritos: ${favoritos.length}
</div>

</div>
</div>
`

}

</script>

</body>
</html>
