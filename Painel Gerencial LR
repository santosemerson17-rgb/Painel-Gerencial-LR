<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Painel de Planilhas</title>

<style>

body{
font-family: Arial;
margin:0;
display:flex;
background:linear-gradient(135deg,#1e1e1e,#2f2f2f);
}

/* MENU LATERAL */

.sidebar{
width:240px;
background:#111827;
color:white;
height:100vh;
padding:20px;
}

.sidebar h2{
margin-bottom:25px;
}

.menu-item{
padding:12px;
margin-bottom:8px;
cursor:pointer;
border-radius:6px;
}

.menu-item:hover{
background:#374151;
}

/* CONTEUDO */

.content{
flex:1;
padding:30px;
}

/* GRID DE PLANILHAS */

.grid{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(260px,1fr));
gap:20px;
}

/* CARD */

.card{
background:white;
padding:20px;
border-radius:10px;
box-shadow:0 4px 10px rgba(0,0,0,0.08);
position:relative;
transition:0.2s;
}

.card:hover{
transform:translateY(-3px);
}

/* TITULO */

.card-title{
font-size:16px;
font-weight:bold;
margin-bottom:10px;
}

/* LINK */

.open-btn{
display:inline-block;
margin-top:10px;
padding:8px 12px;
background:#2563eb;
color:white;
border-radius:6px;
text-decoration:none;
font-size:13px;
}

/* AÇÕES NO CANTO */

.actions{
position:absolute;
top:8px;
right:8px;
display:flex;
gap:5px;
}

.icon{
cursor:pointer;
font-size:14px;
padding:4px;
}

.icon:hover{
transform:scale(1.2);
}

/* SELETOR */

.open-mode{
position:absolute;
bottom:10px;
right:10px;
font-size:20px;
}

.inicio-container{

display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
text-align:center;

background:white;
padding:40px;
border-radius:20px;

box-shadow:0 6px 30px rgba(0,0,0,0.08);

max-width:1000px;
width:500%;
margin:auto;

box-sizing:border-box;
}

.logo{
width:260px;
margin-top:-30px;
margin-bottom:40px;
animation:fadeLogo 1.6s ease;
}

.titulo-painel{

font-size:60px;
font-weight:700;

color:#9ed6a3;

text-align:center;

text-shadow:
0 0 8px rgba(158,214,163,0.6),
0 0 18px rgba(158,214,163,0.4);

margin-bottom:25px;

}

.titulo-painel span{

display:block;
margin-top:10px;

font-size:55px;
font-weight:600;

color:#9ed6a3;

text-shadow:
0 0 8px rgba(158,214,163,0.6),
0 0 18px rgba(158,214,163,0.4);
}

@keyframes fadeLogo{

from{
opacity:0;
transform:translateY(-20px);
}

to{
opacity:1;
transform:translateY(0);
}

}

.inicio-container p{
color:#555;
margin-bottom:30px;
font-size:18px;
}

.info-box{
display:flex;
gap:60px;
margin-bottom:30px;
font-size:16px;
}

.btn-entrar{

background:#2563eb;
color:white;
border:none;
padding:12px 25px;
border-radius:8px;

font-size:16px;
cursor:pointer;
}

.btn-entrar:hover{
background:#1d4ed8;
}


</style>
</head>

<body>

<div class="sidebar">

<h2>Painel</h2>

<div class="menu-item" onclick="abrirInicio('inicio')">🏠 Inicio</div>
<div class="menu-item" onclick="abrirAba('devolucao')">📄 Planilhas de Devolução</div>
<div class="menu-item" onclick="abrirAba('finalizacao')">✅ Finalização de Casos</div>
<div class="menu-item" onclick="abrirAba('app')">📱 APP</div>
<div class="menu-item" onclick="abrirAba('recusas')">🔙 Recusas</div>
<div class="menu-item" onclick="abrirAba('touchpoint')">📍 Touchpoint</div>
<div class="menu-item" onclick="abrirAba('IT')"> 📃 Instrução de trabalho</div>
<div class="menu-item" onclick="abrirAba('favoritos')">⭐ Favoritos</div>

</div>

<div class="content">

<div class="grid" id="grid"></div>

</div>

<script>

let favoritos = JSON.parse(localStorage.getItem("favoritos")) || []


const dados = {

devolucao:[

{
