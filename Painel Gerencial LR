},

{
nome:"Planilha Devolução 2024",
link:"https://agcompany-my.sharepoint.com/:x:/r/personal/amanda_costa_corteva_com1/Documents/LOG%C3%8DSTICA%20REVERSA%20EVOLOG/CONTROLE%20DE%20COLETAS%20LOG%C3%8DSTICA%20REVERSA%20%20-%202024.xlsm?d=w078d23a363c14b5384ca7f3a8188477f&csf=1&web=1&e=XCVJAi"
}

],

finalizacao:[

{
nome:"Encerrar Casos",
link:"https://agcompany-my.sharepoint.com/:x:/r/personal/emerson_santos-1_corteva_com/Documents/Encerrar%20Casos%20Dev.%20e%20Rec..xlsx?d=wb57bb497f785454183630023c043e206&e=4%3a1e056bfcb9c94d548f3961be5ea57fb3&sharingv2=true&fromShare=true&at=9"
}

],

app:[

{
nome:"Link APP",
link:"https://apps.powerapps.com/play/e/default-3e20ecb2-9cb0-4df1-ad7b-914e31dcdda4/a/143483f4-22bd-4b17-af29-1b27d4d00ad4?tenantId=3e20ecb2-9cb0-4df1-ad7b-914e31dcdda4&hint=f76dc52a-1d58-4d90-b3b9-d8d77794b503&sourcetime=1741623115733&source=portal#"
},

{
nome:"Relatório APP Devolução",
